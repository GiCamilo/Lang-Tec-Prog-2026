#include <stdio.h>
#include <stdlib.h>

/* Faça um programa que leia 10 numeros, inteiros positivos, ignorando os negativos e calcule a soma e a mediae mostre a tela.
OBS: somente com 3 variaveis(i,n,s). Não pode ser vetor, não pode usar laço FOR*/


int main(int argc, char *argv[]) {
	int i, n, s;

	// vai fazer 10x a leituran(i<10)
	while(i<10){
		scanf("%d", &n);
		s = 0;
		if(n>0){
			//s += guarda o valor de s e acrescento o valor de n, i++ acrescenta mais um
			s +=n;
			i++;
		}
		
		
	}
	printf("%d | %d",i, i/10  );
	
		
	return 0;
}
