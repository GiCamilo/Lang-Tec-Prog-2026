#include <stdio.h>
#include <stdlib.h>

/* run this program using the console pauser or add your own getch, system("pause") or input loop */

int comp(int a,int b){
	
	if(a > b) return a;
	else return b;
	
}
int comp_menor(int a, int b){
	
	if(a < b) return a;
	else return b;
	
}
int main(int argc, char *argv[]) {
	
	int valor[10];
	int i, maior, menor;
	
	printf("Leia os numeros");
	for (i=0; i<10; i++){
		scanf("%d", &valor[i]);
	}
	
	for (i = 1, maior = valor[0]; i < 5; i = i + 2){
		
		int comp_temp =	comp(valor[i], valor[i + 1]);
		maior = comp(maior, comp_temp);
	
	}
	
	for (i = 9, menor = valor[10]; i > 5; i = i - 2){
		
		int temp = comp_menor(valor[i], valor[i + 1]);
		menor = comp_menor(menor, temp);
	}
	
	printf("\n%d tem mais aura dos 5 primeiros", maior);
	printf("\no que tem menos aura dos 5 ultimos e o %d", menor);
	
	return 0;
}
